---
import { Icon } from "astro-icon/components";
import { SERVICIOS_DATA } from "@globals/servicios";
---

<section id="servicios" class="py-24 md:py-32 relative overflow-hidden">
    <!-- Luz ambiental central -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[500px] bg-brand-cyan/10 blur-[150px] rounded-full pointer-events-none z-0"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">

        <!-- Encabezado -->
        <div class="text-center max-w-3xl mx-auto mb-16">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-brand-cyan/30 bg-brand-cyan/5 text-brand-cyan text-xs font-semibold tracking-wide uppercase mb-4 shadow-sm shadow-brand-cyan/10">
                <span class="w-2 h-2 rounded-full bg-brand-cyan animate-pulse"></span>
                Áreas de Especialización
            </div>

            <h2 class="text-3xl md:text-5xl font-bold text-white tracking-tight">
                Capacidades técnicas para <span class="text-brand-cyan">escalar tu negocio</span>
            </h2>
            <p class="text-slate-300 text-sm md:text-base mt-4 leading-relaxed">
                Soluciones de alta precisión adaptadas a los estándares de seguridad e infraestructura modernos.
            </p>
        </div>

        <!-- Grid de Tarjetas Limpias y Simétricas -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {SERVICIOS_DATA.map((servicio, index) => (
                <div 
                    data-service-trigger={JSON.stringify(servicio)}
                    class="open-modal-btn group relative p-8 sm:p-10 rounded-3xl bg-brand-surface/50 border border-brand-border/60 hover:border-brand-cyan/50 backdrop-blur-md transition-all duration-300 hover:shadow-2xl hover:shadow-brand-cyan/10 flex flex-col justify-between overflow-hidden cursor-pointer"
                >
                    <div class="absolute -top-20 -right-20 w-48 h-48 bg-brand-cyan/10 blur-2xl rounded-full group-hover:bg-brand-cyan/25 transition-all duration-500 pointer-events-none"></div>

                    <div>
                        <!-- Header de Card -->
                        <div class="flex items-center justify-between mb-6">
                            <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-brand-cyan/20 to-brand-cyan/5 border border-brand-cyan/30 flex items-center justify-center text-brand-cyan shadow-inner group-hover:scale-105 group-hover:border-brand-cyan/60 transition-all duration-300">
                                <Icon name={servicio.icon} class="w-7 h-7" />
                            </div>
                            <span class="font-mono text-xs font-bold text-slate-500 group-hover:text-brand-cyan transition-colors">
                                0{index + 1} //
                            </span>
                        </div>

                        <!-- Título y Descripción -->
                        <h3 class="text-2xl font-bold text-white mb-3 group-hover:text-brand-cyan transition-colors">
                            {servicio.title}
                        </h3>
                        <p class="text-slate-300 text-sm leading-relaxed mb-6">
                            {servicio.description}
                        </p>
                    </div>

                    <!-- Footer de la tarjeta: Acción clara + Badge de características -->
                    <div class="flex items-center justify-between pt-6 border-t border-brand-border/40 mt-2">
                        <span class="inline-flex items-center gap-2 text-xs font-bold text-brand-cyan group-hover:text-white transition-colors">
                            Ver detalles técnicos
                            <Icon name="arrow-right-icon" class="w-4 h-4 transition-transform group-hover:translate-x-1.5" />
                        </span>

                        <span class="text-[10px] font-mono px-2.5 py-1 rounded-md bg-brand-cyan/10 text-brand-cyan border border-brand-cyan/20">
                            {servicio.features.length} especificaciones
                        </span>
                    </div>
                </div>
            ))}
        </div>

    </div>

    <!-- MODAL DE DETALLES TÉCNICOS -->
    <div id="service-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6 bg-slate-950/80 backdrop-blur-md transition-opacity">
        <div class="relative w-full max-w-2xl bg-brand-surface/95 border border-brand-cyan/40 rounded-3xl p-6 sm:p-10 shadow-2xl shadow-brand-cyan/10 overflow-hidden transform transition-all">
            
            <button id="close-modal" class="absolute top-6 right-6 p-2 rounded-full text-slate-400 hover:text-white hover:bg-brand-dark/80 transition-all cursor-pointer">
                <Icon name="close-icon" class="w-6 h-6" />
            </button>

            <div class="flex items-center gap-4 mb-6">
                <div id="modal-icon-container" class="w-14 h-14 rounded-2xl bg-brand-cyan/10 border border-brand-cyan/30 flex items-center justify-center text-brand-cyan shrink-0">
                </div>
                <div>
                    <span class="text-xs font-mono text-brand-cyan uppercase tracking-wider">Ficha Técnica de Servicio</span>
                    <h3 id="modal-title" class="text-2xl font-bold text-white"></h3>
                </div>
            </div>

            <p id="modal-description" class="text-slate-300 text-sm leading-relaxed mb-6"></p>

            <div class="mb-8">
                <h4 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-4">Alcance y Capacidades Incluidas</h4>
                <ul id="modal-features" class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                </ul>
            </div>

            <div class="flex flex-col sm:flex-row items-center gap-4 border-t border-brand-border/40 pt-6">
                <a 
                    id="modal-cta"
                    href="#contacto" 
                    class="w-full sm:w-auto flex-1 py-3.5 px-6 rounded-xl font-bold bg-cyan-400 hover:bg-cyan-300 text-slate-950 text-center text-sm transition-all shadow-lg shadow-cyan-400/20 cursor-pointer"
                >
                    Cotizar este Servicio
                </a>
                <button id="close-modal-secondary" type="button" class="w-full sm:w-auto py-3.5 px-6 rounded-xl font-semibold text-slate-300 hover:text-white border border-brand-border/80 hover:bg-brand-dark/60 text-sm transition-all cursor-pointer">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</section>

<script>
    const setupModal = () => {
        const modal = document.getElementById('service-modal');
        const closeModalBtn = document.getElementById('close-modal');
        const closeModalSecondary = document.getElementById('close-modal-secondary');
        const triggerBtns = document.querySelectorAll<HTMLElement>('.open-modal-btn');

        const modalTitle = document.getElementById('modal-title');
        const modalDescription = document.getElementById('modal-description');
        const modalFeatures = document.getElementById('modal-features');
        const modalIconContainer = document.getElementById('modal-icon-container');
        const modalCta = document.getElementById('modal-cta');

        if (!modal) return;

        const openModal = (data: any) => {
            if (modalTitle) modalTitle.textContent = data.title;
            if (modalDescription) modalDescription.textContent = data.description;
            
            if (modalIconContainer) {
                modalIconContainer.innerHTML = `<svg class="w-7 h-7" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>`;
            }

            if (modalFeatures) {
                modalFeatures.innerHTML = data.features.map((feature: string) => `
                    <li class="flex items-start gap-2.5 p-3 rounded-xl bg-brand-dark/60 border border-brand-border/50 text-xs text-slate-200">
                        <span class="w-2 h-2 rounded-full bg-brand-cyan mt-1 shrink-0"></span>
                        <span>${feature}</span>
                    </li>
                `).join('');
            }

            if (modalCta) {
                modalCta.onclick = () => {
                    modal.classList.add('hidden');
                    modal.classList.remove('flex');
                    
                    const chip = document.querySelector<HTMLButtonElement>(`[data-value="${data.title}"]`);
                    if (chip) chip.click();
                };
            }

            modal.classList.remove('hidden');
            modal.classList.add('flex');
        };

        const closeModal = () => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        };

        triggerBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const dataRaw = btn.getAttribute('data-service-trigger');
                if (dataRaw) {
                    openModal(JSON.parse(dataRaw));
                }
            });
        });

        closeModalBtn?.addEventListener('click', closeModal);
        closeModalSecondary?.addEventListener('click', closeModal);

        modal.addEventListener('click', (e) => {
            if (e.target === modal) closeModal();
        });
    };

    document.addEventListener('DOMContentLoaded', setupModal);
    document.addEventListener('astro:page-load', setupModal);
</script>