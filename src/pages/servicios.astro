---
import MainLayouts from "@layouts/MainLayouts.astro";

import { Icon } from "astro-icon/components";

---

<MainLayouts title="Servicios">
    <section id="servicios" class="py-24 bg-brand-midnight/40 border-t border-brand-border/40 relative mt-18">
        <div class="max-w-7xl mx-auto px-6">

            <div class="text-center max-w-4xl mx-auto mb-16">
                <!-- <h2 class="text-brand-cyan text-sm font-bold tracking-widest uppercase">Áreas de Especialización</h2> -->

                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-brand-cyan/30 bg-brand-cyan/5 text-brand-cyan text-[9.5px] md:text-xs font-semibold tracking-wide uppercase mb-2">
                    <span class="w-2 h-2 rounded-full bg-brand-cyan animate-pulse"></span>
                    Áreas de Especialización
                </div>

                <p class="text-4xl font-bold text-white mt-2">Capacidades técnicas diseñadas para escalar</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                
                <div class="p-8 rounded-2xl bg-brand-surface/40 border border-brand-border/60 hover:border-brand-cyan/40 transition-all group">
                    <div class="w-12 h-12 rounded-xl bg-brand-cyan/10 border border-brand-cyan/20 flex items-center justify-center text-brand-cyan mb-6 group-hover:scale-105 transition-transform">
                        <Icon name="code-icon" class="w-6 h-6" />
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Desarrollo de Software</h3>
                    <p class="text-slate-300 text-sm leading-relaxed mb-4">
                        Construcción de aplicaciones web, plataformas empresariales y APIs robustas optimizadas para alta disponibilidad, escalabilidad y rendimiento seguro desde el diseño.
                    </p>
                    <ul class="text-xs text-slate-200 space-y-2">
                        <li class="flex items-center gap-2">
                            <Icon name="check-icon" class="w-4 h-4 text-brand-cyan" /> Arquitecturas Cloud-Native
                        </li>
                        <li class="flex items-center gap-2">
                            <Icon name="check-icon" class="w-4 h-4 text-brand-cyan" /> Integraciones de API y Automatización
                        </li>
                    </ul>
                </div>

                <div class="p-8 rounded-2xl bg-brand-surface/40 border border-brand-border/60 hover:border-brand-cyan/40 transition-all group">
                    <div class="w-12 h-12 rounded-xl bg-brand-blue/10 border border-brand-blue/30 flex items-center justify-center text-brand-cyan mb-6 group-hover:scale-105 transition-transform">
                        <Icon name="network-icon" class="w-6 h-6" />
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Asesorías Informáticas</h3>
                    <p class="text-slate-300 text-sm leading-relaxed mb-4">
                        Consultoría técnica estratégica para optimizar tu infraestructura de TI, migración de servidores, gestión de bases de datos y modernización de stacks tecnológicos.
                    </p>
                    <ul class="text-xs text-slate-200 space-y-2">
                        <li class="flex items-center gap-2">
                            <Icon name="check-icon" class="w-4 h-4 text-brand-cyan" /> Auditoría de Infraestructura y Redes
                        </li>
                        <li class="flex items-center gap-2">
                            <Icon name="check-icon" class="w-4 h-4 text-brand-cyan" />  Optimización de Procesos Digitales
                        </li>
                    </ul>
                </div>

                <div class="p-8 rounded-2xl bg-brand-surface/40 border border-brand-border/60 hover:border-brand-cyan/40 transition-all group">
                    <div class="w-12 h-12 rounded-xl bg-brand-cyan/10 border border-brand-cyan/20 flex items-center justify-center text-brand-cyan mb-6 group-hover:scale-105 transition-transform">
                        <Icon name="shield-check-icon" class="w-6 h-6" />
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Ciberseguridad & Normativa Legal</h3>
                    <p class="text-slate-300 text-sm leading-relaxed mb-4">
                        Evaluación de vulnerabilidades, planes de respuesta a incidentes y adecuación a leyes de protección de datos y marcos regulatorios de seguridad corporativa.
                    </p>
                    <ul class="text-xs text-slate-200 space-y-2">
                        <li class="flex items-center gap-2">
                            <Icon name="check-icon" class="w-4 h-4 text-brand-cyan" />  Pentesting y Análisis de Riesgos
                        </li>
                        <li class="flex items-center gap-2">
                            <Icon name="check-icon" class="w-4 h-4 text-brand-cyan" />  Cumplimiento Normativo y Protección de Datos
                        </li>
                    </ul>
                </div>

                <div class="p-8 rounded-2xl bg-brand-surface/40 border border-brand-border/60 hover:border-brand-cyan/40 transition-all group">
                    <div class="w-12 h-12 rounded-xl bg-brand-blue/10 border border-brand-blue/30 flex items-center justify-center text-brand-cyan mb-6 group-hover:scale-105 transition-transform">
                        <Icon name="terminal-icon" class="w-6 h-6" />
                    </div>
                    <h3 class="text-xl font-bold text-white mb-3">Soporte Técnico Computacional</h3>
                    <p class="text-slate-300 text-sm leading-relaxed mb-4">
                        Mantenimiento preventivo y correctivo de hardware/software, administración de servidores, soporte remoto y resolución de contingencias críticas en tiempo real.
                    </p>
                    <ul class="text-xs text-slate-200 space-y-2">
                        <li class="flex items-center gap-2">
                            <Icon name="check-icon" class="w-4 h-4 text-brand-cyan" />  Monitoreo Proactivo y Helpdesk
                        </li>
                        <li class="flex items-center gap-2">
                            <Icon name="check-icon" class="w-4 h-4 text-brand-cyan" /> Continuidad Operativa y Backups
                        </li>
                    </ul>
                </div>

            </div>
        </div>
    </section>
</MainLayouts>