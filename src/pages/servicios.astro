---
import { Icon } from "astro-icon/components";
import { SERVICIOS_DATA } from "@globals/servicios";

---

<section id="servicios" class="py-24 relative overflow-hidden">
    <div class="absolute top-80 right-20 -translate-y-12 translate-x-1/3 w-[500px] h-[600px] bg-brand-cyan/15 blur-[120px] rounded-full pointer-events-none z-0"></div>
    <div class="absolute top-80 -left-60 -translate-y-12 translate-x-1/3 w-[500px] h-[600px] bg-brand-cyan/15 blur-[120px] rounded-full pointer-events-none z-0 hidden md:block"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">

        <!-- Encabezado -->
        <div class="text-center max-w-4xl mx-auto mb-16">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-brand-cyan/30 bg-brand-cyan/5 text-brand-cyan text-[9.5px] md:text-xs font-semibold tracking-wide uppercase mb-2">
                <span class="w-2 h-2 rounded-full bg-brand-cyan animate-pulse"></span>
                Áreas de Especialización
            </div>

            <h2 class="text-3xl md:text-4xl font-bold text-white mt-2">
                Capacidades técnicas diseñadas para escalar
            </h2>
        </div>

        <!-- Renderizado dinámico de la lista de servicios -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {SERVICIOS_DATA.map((servicio) => (
                <div class="p-8 rounded-2xl bg-brand-surface/40 border border-brand-border/60 hover:border-brand-cyan/40 transition-all group flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-xl bg-brand-cyan/10 border border-brand-cyan/20 flex items-center justify-center text-brand-cyan mb-6 group-hover:scale-105 transition-transform">
                            <Icon name={servicio.icon} class="w-6 h-6" />
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">{servicio.title}</h3>
                        <p class="text-slate-300 text-sm leading-relaxed mb-4">
                            {servicio.description}
                        </p>
                    </div>

                    <ul class="text-xs text-slate-200 space-y-2 border-t border-white/9 pt-4">
                        {servicio.features.map((feature) => (
                            <li class="flex items-center gap-2">
                                <Icon name="check-icon" class="w-4 h-4 text-brand-cyan shrink-0" />
                                <span>{feature}</span>
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>

    </div>
</section>