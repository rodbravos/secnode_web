---
import { Icon } from "astro-icon/components";
import { SOLUCIONES_DATA } from "@globals/soluciones";
---

<section id="soluciones" class="py-24 relative bg-[linear-gradient(to_right,rgba(0,229,255,0.12)_1px,transparent_1px),linear-gradient(to_bottom,rgba(0,229,255,0.12)_1px,transparent_1px)] bg-size-[32px_32px]">
    
    <!-- Resplandor central -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,229,255,0.04)_0%,transparent_70%)] pointer-events-none z-0"></div>

    <!-- Gradiente de difuminado top/bottom -->
    <div class="absolute inset-0 bg-linear-to-b from-[#0b1120] via-transparent to-[#0b1120] pointer-events-none z-0"></div>
    
    <div class="max-w-7xl mx-auto px-6 relative z-10">
        
        <!-- Encabezado -->
        <div class="text-center max-w-3xl mx-auto mb-16">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-orange-500/30 bg-orange-500/10 text-orange-400 text-xs font-semibold tracking-wide uppercase mb-4">
                <span class="w-2 h-2 rounded-full bg-orange-400 animate-pulse"></span>
                Enfoque de Negocio
            </div>
            <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight">
                Soluciones integrales para desafíos complejos
            </h2>
            <p class="text-slate-300 text-base mt-4 italic">
                Diseñamos arquitecturas y servicios alineados directamente a los objetivos de continuidad y crecimiento de tu empresa.
            </p>
        </div>

        <!-- Grid de Soluciones -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {SOLUCIONES_DATA.map((sol) => (
                <div class="p-8 rounded-2xl bg-[#0b1120]/80 border border-brand-cyan/20 backdrop-blur-sm hover:border-brand-cyan/60 transition-all flex flex-col justify-between group">
                    <div>
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-xs font-mono text-brand-cyan uppercase tracking-wider">{sol.tag}</span>
                            <div class="w-10 h-10 rounded-lg bg-brand-cyan/10 border border-brand-cyan/30 flex items-center justify-center text-brand-cyan group-hover:scale-110 transition-transform">
                                <Icon name={sol.icon} class="w-5 h-5" />
                            </div>
                        </div>

                        <h3 class="text-xl font-bold text-white mb-3">{sol.title}</h3>
                        <p class="text-slate-300 text-sm leading-relaxed mb-6">{sol.description}</p>
                    </div>

                    <ul class="border-t border-white/10 pt-4 space-y-2">
                        {sol.features.map((feat) => (
                            <li class="text-xs text-slate-300 flex items-center gap-2">
                                <span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span>
                                {feat}
                            </li>
                        ))}
                    </ul>
                </div>
            ))}
        </div>

    </div>
</section>