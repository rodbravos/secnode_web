---
import { Icon } from "astro-icon/components";


---

<section id="contacto" class="py-24 relative overflow-hidden">
    <!-- El fondo radial crea un "foco" en el centro -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,var(--tw-gradient-stops))] from-brand-midnight/40 via-brand-dark to-brand-dark pointer-events-none"></div>
    
    <div class="max-w-5xl mx-auto px-6">


        <div class="p-8 sm:p-12 rounded-3xl bg-brand-surface/50 border border-brand-cyan relative overflow-hidden">
            <div class="text-center max-w-xl mx-auto mb-10">
                <h2 class="text-3xl font-bold text-white">
                    Inicia tu proyecto con <span class="font-bold text-white"><span class="text-brand-cyan">SEC</span>NODE</span>
                </h2>
                <p class="text-slate-200 text-sm mt-2">Completa el formulario y un especialista técnico evaluará tus requerimientos.</p>
            </div>

            <form class="space-y-6" onsubmit="event.preventDefault(); alert('Mensaje enviado con éxito.');">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-semibold text-slate-200 mb-2 uppercase">Nombre Completo</label>
                        <input type="text" required class="w-full px-4 py-3 rounded-lg bg-brand-dark/70 border border-brand-border focus:border-brand-cyan focus:outline-none text-white text-sm" placeholder="Ej. Alex Turner">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-200 mb-2 uppercase">Correo Electrónico</label>
                        <input type="email" required class="w-full px-4 py-3 rounded-lg bg-brand-dark/70 border border-brand-border focus:border-brand-cyan focus:outline-none text-white text-sm" placeholder="contacto@empresa.com">
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-xs font-semibold text-slate-200 mb-2 uppercase">Teléfono</label>
                        <input type="text" required class="w-full px-4 py-3 rounded-lg bg-brand-dark/70 border border-brand-border focus:border-brand-cyan focus:outline-none text-white text-sm" placeholder="Ej. 569 4444 0000">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-200 mb-2 uppercase">
                            Nombre empresa / institución (Opcional)
                        </label>
                        <input type="email" required class="w-full px-4 py-3 rounded-lg bg-brand-dark/70 border border-brand-border focus:border-brand-cyan focus:outline-none text-white text-sm" placeholder="contacto@empresa.com">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-200 mb-2 uppercase">Servicio de Interés</label>
                    <select class="w-full px-4 py-3 rounded-lg bg-brand-dark/70 border border-brand-border focus:border-brand-cyan focus:outline-none text-white text-sm">
                        <option>Desarrollo de Software</option>
                        <option>Asesorías Informáticas</option>
                        <option>Ciberseguridad y Normativa Legal</option>
                        <option>Soporte Técnico Computacional</option>
                        <option>Consultoría Integral</option>
                        <option>Otros</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-200 mb-2 uppercase">Detalles del Requerimiento</label>
                    <textarea 
                        rows="4" 
                        required class="w-full px-4 py-3 rounded-lg bg-brand-dark/70 border border-brand-border focus:border-brand-cyan focus:outline-none text-white text-sm" 
                        placeholder="Describe brevemente tus necesidades técnicas..."
                    ></textarea>
                </div>

                <button type="submit" class="w-full py-4 rounded-lg font-bold bg-cyan-400 hover:bg-linear-to-br hover:from-brand-cyan hover:to-brand-blue text-brand-dark transition-all">
                    <span class="flex justify-center items-center gap-2">
                        <Icon name="send-icon" class="w-6 h-6" /> Enviar Solicitud
                    </span>
                </button>
            </form>
        </div>




    </div>
</section>