---
import { Icon } from "astro-icon/components";

const servicios = [
    "Desarrollo Software",
    "Ciberseguridad",
    "Asesoría TI",
    "Soporte Técnico",
    "Consultoría",
    "Otros"
];
---

<section id="contacto" class="pt-24 pb-36 md:pb-44 relative overflow-hidden">
    <!-- Luz ambiental emergiendo hacia el Footer -->
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 w-[900px] h-[600px] bg-brand-cyan/20 blur-[160px] rounded-full pointer-events-none z-0"></div>

    <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="p-8 sm:p-12 lg:p-16 rounded-3xl bg-brand-surface/60 border border-brand-cyan/30 backdrop-blur-md shadow-2xl shadow-brand-cyan/5">
            
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
                
                <!-- Columna Izquierda: Mensaje cercano + Métricas/Contacto -->
                <div class="lg:col-span-5 space-y-8">
                    <div>
                        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-cyan/10 border border-brand-cyan/30 text-brand-cyan text-[10px] md:text-xs font-semibold uppercase tracking-wider mb-4">
                            <span class="w-2 h-2 rounded-full bg-brand-cyan animate-pulse"></span>
                            Disponibles para nuevos proyectos
                        </span>
                        <h2 class="text-3xl sm:text-4xl font-bold text-white leading-tight">
                            ¿Hablamos de tu próximo <span class="text-brand-cyan">desafío tecnológico</span>?
                        </h2>
                        <p class="text-slate-300 text-sm sm:text-base mt-4 leading-relaxed">
                            Analizamos la arquitectura de tus sistemas y proponemos soluciones a medida. Cuéntanos qué necesitas y nos pondremos en contacto rápidamente.
                        </p>
                    </div>

                    <!-- Datos rápidos de contacto & Confianza -->
                    <div class="space-y-4 pt-4 border-t border-brand-border/40">
                        <div class="flex items-center gap-4 text-slate-300 text-sm">
                            <div class="w-10 h-10 rounded-xl bg-brand-dark/80 border border-brand-border/60 flex items-center justify-center text-brand-cyan shrink-0">
                                <Icon name="clock-fast-icon" class="w-5 h-5" />
                            </div>
                            <div>
                                <p class="text-white font-medium text-xs uppercase tracking-wider">Tiempo de respuesta</p>
                                <p class="text-slate-400 text-xs">Menos de 24 horas hábiles</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-4 text-slate-300 text-sm">
                            <div class="w-10 h-10 rounded-xl bg-brand-dark/80 border border-brand-border/60 flex items-center justify-center text-brand-cyan shrink-0">
                                <Icon name="shield-check-icon" class="w-5 h-5" />
                            </div>
                            <div>
                                <p class="text-white font-medium text-xs uppercase tracking-wider">Confidencialidad</p>
                                <p class="text-slate-400 text-xs">Acuerdo de confidencialidad (NDA) disponible</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Columna Derecha: Formulario de Interacción -->
                <div class="lg:col-span-7">
                    <form class="space-y-6" onsubmit="event.preventDefault(); alert('Mensaje enviado con éxito.');">
                        
                        <!-- Inputs Nombre y Email -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-xs font-semibold text-slate-300 mb-2 uppercase">Tu Nombre</label>
                                <input type="text" required class="w-full px-4 py-3.5 rounded-xl bg-brand-dark/80 border border-brand-border/80 focus:border-brand-cyan focus:ring-2 focus:ring-brand-cyan/20 focus:outline-none text-white text-sm transition-all" placeholder="Alex Turner">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-300 mb-2 uppercase">Correo Electrónico</label>
                                <input type="email" required class="w-full px-4 py-3.5 rounded-xl bg-brand-dark/80 border border-brand-border/80 focus:border-brand-cyan focus:ring-2 focus:ring-brand-cyan/20 focus:outline-none text-white text-sm transition-all" placeholder="alex@empresa.com">
                            </div>
                        </div>

                        <!-- Inputs Teléfono y Empresa -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-xs font-semibold text-slate-300 mb-2 uppercase">Teléfono / WhatsApp</label>
                                <input type="tel" required class="w-full px-4 py-3.5 rounded-xl bg-brand-dark/80 border border-brand-border/80 focus:border-brand-cyan focus:ring-2 focus:ring-brand-cyan/20 focus:outline-none text-white text-sm transition-all" placeholder="+56 9 1234 5678">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-300 mb-2 uppercase">Empresa (Opcional)</label>
                                <input type="text" class="w-full px-4 py-3.5 rounded-xl bg-brand-dark/80 border border-brand-border/80 focus:border-brand-cyan focus:ring-2 focus:ring-brand-cyan/20 focus:outline-none text-white text-sm transition-all" placeholder="Nombre de tu empresa">
                            </div>
                        </div>

                        <!-- Selección por Chips de Servicio -->
                        <div>
                            <label class="block text-xs font-semibold text-slate-300 mb-3 uppercase">¿En qué área necesitas apoyo?</label>
                            <input type="hidden" id="selected-service" name="service" value="Desarrollo Software" />
                            
                            <div class="flex flex-wrap gap-2.5" id="service-chips">
                                {servicios.map((servicio, index) => (
                                    <button 
                                        type="button" 
                                        data-value={servicio}
                                        class={`chip-btn text-xs font-semibold px-4 py-2.5 rounded-lg border transition-all cursor-pointer ${
                                            index === 0 
                                            ? 'bg-brand-cyan/20 border-brand-cyan text-white shadow-sm shadow-brand-cyan/20' 
                                            : 'bg-brand-dark/50 border-brand-border/80 text-slate-300 hover:border-brand-cyan/50 hover:text-white'
                                        }`}
                                    >
                                        {servicio}
                                    </button>
                                ))}
                            </div>
                        </div>

                        <!-- Detalle del Proyecto -->
                        <div>
                            <label class="block text-xs font-semibold text-slate-300 mb-2 uppercase">Detalles del Requerimiento</label>
                            <textarea 
                                rows="4" 
                                required 
                                class="w-full px-4 py-3.5 rounded-xl bg-brand-dark/80 border border-brand-border/80 focus:border-brand-cyan focus:ring-2 focus:ring-brand-cyan/20 focus:outline-none text-white text-sm transition-all resize-none" 
                                placeholder="Describe brevemente tus requerimientos o problemas actuales..."
                            ></textarea>
                        </div>

                        <!-- Botón Enviar -->
                        <button type="submit" class="w-full py-4 rounded-xl font-bold bg-cyan-400 hover:bg-cyan-300 text-slate-950 transition-all duration-200 shadow-lg shadow-cyan-400/15 hover:shadow-cyan-400/25 active:scale-[0.99] cursor-pointer">
                            <span class="flex justify-center items-center gap-2">
                                <Icon name="send-icon" class="w-5 h-5" /> Solicitar Asesoría Técnica
                            </span>
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</section>

<script>
    // Lógica para alternar la selección de chips de servicios
    const setupServiceChips = () => {
        const chips = document.querySelectorAll<HTMLButtonElement>('.chip-btn');
        const hiddenInput = document.getElementById('selected-service') as HTMLInputElement;

        chips.forEach((chip) => {
            chip.addEventListener('click', () => {
                chips.forEach((c) => {
                    c.classList.remove('bg-brand-cyan/20', 'border-brand-cyan', 'text-white', 'shadow-sm', 'shadow-brand-cyan/20');
                    c.classList.add('bg-brand-dark/50', 'border-brand-border/80', 'text-slate-300');
                });

                chip.classList.add('bg-brand-cyan/20', 'border-brand-cyan', 'text-white', 'shadow-sm', 'shadow-brand-cyan/20');
                chip.classList.remove('bg-brand-dark/50', 'border-brand-border/80', 'text-slate-300');

                if (hiddenInput) {
                    hiddenInput.value = chip.dataset.value || '';
                }
            });
        });
    };

    document.addEventListener('DOMContentLoaded', setupServiceChips);
    document.addEventListener('astro:page-load', setupServiceChips);
</script>