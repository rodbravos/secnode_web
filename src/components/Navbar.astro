---
const links = [
    { href: '/', text: 'Inicio' },
    { href: '/servicios', text: 'Servicios' },
    { href: '/soluciones', text: 'Soluciones' },
    { href: '/contacto', text: 'Contacto' },
];

const currentPath = Astro.url.pathname;
// console.log(currentPath===links.href);

---


<header class="fixed top-0 w-full z-50 bg-brand-dark/80 backdrop-blur-md border-gradient-bottom shadow-[0_4px_25px_rgba(0,229,255,0.15)]">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        <!-- LOGO -->
        <a href="/" class="flex items-center gap-3">
            <svg class="w-9 h-9" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                <defs>
                    <linearGradient id="brandGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stop-color="#00E5FF"></stop>
                        <stop offset="100%" stop-color="#0066FF"></stop>
                    </linearGradient>
                </defs>
                <path d="M50 10 L85 25 V50 C85 70 50 90 50 90 C50 90 15 70 15 50 V25 L50 10Z" stroke="url(#brandGrad)" stroke-width="7" stroke-linejoin="round" fill="none"></path>
                <path d="M35 65 V35 L65 65 V35" stroke="url(#brandGrad)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M25 75 L75 25 M75 25 H60 M75 25 V40" stroke="url(#brandGrad)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            
            <span class="text-xl font-bold tracking-wider text-white">
                <span class="text-brand-cyan">SEC</span>NODE
            </span>
        </a>

        <!-- NAVEGACIÓN DESKTOP -->
        <nav class="hidden md:flex items-center gap-8 text-base font-medium">
        {
            links.map( ({ href, text}) => (
                <div>
                    <a 
                        href={ href } 
                        class="text-slate-200 hover:text-brand-cyan transition-colors"
                    >
                        { text }
                    </a>
                    { currentPath === href ? (
                        <div
                            transition:name="menu-line"
                            class="border-b-2 border-blue-500 mt-1"
                        />
                    ) : (
                        <div
                            class="border-b-2 border-transparent mt-1"
                        />
                    )}
                </div>
            ))
        }
        </nav>

        <!-- CTA DESKTOP -->
        <div class="hidden md:block">
            <a href="#contacto" class="px-5 py-2.5 rounded-lg text-sm font-semibold bg-cyan-400 text-slate-900 hover:bg-cyan-200 transition-all glow-effect">
                Agendar Asesoría
            </a>
        </div>

        <!-- BOTÓN HAMBURGUESA MOBILE -->
        <button id="mobile-menu-btn" class="md:hidden flex items-center justify-center p-2 text-slate-200 hover:text-brand-cyan focus:outline-none transition-colors" aria-label="Abrir menú">
            <svg id="icon-open" class="w-7 h-7 block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg id="icon-close" class="w-7 h-7 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </div>

    <!-- MENÚ MOBILE DESPLEGABLE -->
    <div id="mobile-menu" class="hidden md:hidden bg-brand-dark/95 backdrop-blur-xl border-b border-brand-border/50 shadow-2xl">
        <nav class="flex flex-col px-6 py-6 space-y-4">
            {
                links.map( ({ href, text}) => (
                    <a 
                        href={ href } 
                        class={`text-lg font-medium pb-2 border-b border-slate-800 ${currentPath === href ? 'text-brand-cyan' : 'text-slate-200 hover:text-brand-cyan'}`}
                    >
                        { text }
                    </a>
                ))
            }
            <div class="pt-4">
                <a href="#contacto" class="block w-full text-center px-5 py-3 rounded-lg text-base font-semibold bg-cyan-400 text-slate-900 hover:bg-cyan-200 transition-all glow-effect">
                    Agendar Asesoría
                </a>
            </div>
        </nav>
    </div>
</header>

<script>
    // Usamos una función para poder llamarla tanto en la carga inicial como en las transiciones de Astro
    function setupMobileMenu() {
        const btn       = document.getElementById('mobile-menu-btn');
        const menu      = document.getElementById('mobile-menu');
        const iconOpen  = document.getElementById('icon-open');
        const iconClose = document.getElementById('icon-close');

        if (btn && menu && iconOpen && iconClose) {
            // Removemos listeners previos para evitar que se dupliquen al navegar
            const newBtn = btn.cloneNode(true);
            btn.parentNode?.replaceChild(newBtn, btn);

            newBtn.addEventListener('click', () => {
                menu.classList.toggle('hidden');
                iconOpen?.classList.toggle('hidden');
                iconClose?.classList.toggle('hidden');
                
                if (!menu.classList.contains('hidden')) {
                    menu.classList.add('animate-fade-in-down');
                }
            });
        }
    }

    // Ejecutar en la carga normal de la página
    setupMobileMenu();

    // Ejecutar cuando Astro View Transitions actualiza la página
    document.addEventListener('astro:page-load', setupMobileMenu);
</script>